{
  "$schema": "https://unpkg.com/@jambonz/upgrade-manifest@1/upgrade-manifest.schema.json",
  "schema_version": "1",
  "source_version": "10.2.0",
  "target_version": "10.2.1",
  "min_daemon_version": "1.0.0",
  "variant": "mini",
  "distro": "debian-12",
  "arch": "amd64",
  "expected_downtime_seconds": 240,
  "release_notes_url": "https://jambonz.org/releases/10.2.1",
  "created_at": "2026-05-08T00:00:00.000Z",
  "steps": [
    {
      "id": "drachtio",
      "kind": "install_drachtio",
      "title": "Installing drachtio 0.9.7",
      "version": "0.9.7",
      "url": "https://jambonz-debs.s3.amazonaws.com/drachtio/drachtio_0.9.7_debian-12_amd64.deb",
      "sha256": "abc1234567890abcdef1234567890abcdef1234567890abcdef1234567890abc"
    },
    {
      "id": "freeswitch",
      "kind": "install_freeswitch",
      "title": "Installing FreeSWITCH 1.10.12",
      "version": "1.10.12",
      "url": "https://jambonz-debs.s3.amazonaws.com/jambonz-freeswitch/jambonz-freeswitch_1.10.12_debian-12_amd64.deb",
      "sha256": "def1234567890abcdef1234567890abcdef1234567890abcdef1234567890abc",
      "timeout_seconds": 300
    },
    {
      "id": "upload-recordings",
      "kind": "install_upload_recordings",
      "title": "Installing upload_recordings 1.9.0",
      "version": "1.9.0",
      "url": "https://jambonz-debs.s3.amazonaws.com/jambonz-upload-recordings/jambonz-upload-recordings_1.9.0_debian-12_amd64.deb",
      "sha256": "111234567890abcdef1234567890abcdef1234567890abcdef1234567890abca"
    },
    {
      "id": "pcap-server",
      "kind": "install_pcap_server",
      "title": "Installing pcap-server 1.0.0",
      "version": "1.0.0",
      "url": "https://jambonz-debs.s3.amazonaws.com/pcap-server/pcap-server_1.0.0_debian-12_amd64.deb",
      "sha256": "222234567890abcdef1234567890abcdef1234567890abcdef1234567890abca"
    },
    {
      "id": "telegraf",
      "kind": "install_deb",
      "title": "Upgrading telegraf to 1.30.0",
      "package_name": "telegraf",
      "version": "1.30.0",
      "url": "https://jambonz-debs.s3.amazonaws.com/telegraf/telegraf_1.30.0_debian-12_amd64.deb",
      "sha256": "333234567890abcdef1234567890abcdef1234567890abcdef1234567890abca",
      "restart_units": ["telegraf"]
    },
    {
      "id": "apps",
      "kind": "install_node_apps",
      "title": "Upgrading Node.js apps to 10.2.1",
      "version": "10.2.1",
      "url": "https://jambonz-debs.s3.amazonaws.com/apps/jambonz-apps_10.2.1_debian-12_amd64.tar.gz",
      "sha256": "444234567890abcdef1234567890abcdef1234567890abcdef1234567890abca"
    },
    {
      "id": "schema",
      "kind": "run_db_migration",
      "title": "Updating database schema",
      "command": "node /home/jambonz/apps/api-server/db/upgrade-jambonz-db.js",
      "run_as": "jambonz",
      "timeout_seconds": 600
    },
    {
      "id": "patch-eco",
      "kind": "patch_ecosystem_env",
      "title": "Adding new env var to feature-server",
      "patches": [
        {
          "op": "set_env",
          "app": "feature-server",
          "key": "JAMBONES_ENABLE_NEW_FEATURE",
          "value": "1"
        },
        {
          "op": "unset_env",
          "app": "webapp",
          "key": "OBSOLETE_FLAG"
        }
      ]
    },
    {
      "id": "patch-drachtio-svc",
      "kind": "patch_systemd_env",
      "title": "Adding new env var to drachtio.service",
      "patches": [
        {
          "op": "set_env",
          "unit": "drachtio.service",
          "key": "DRACHTIO_NEW_OPT",
          "value": "1"
        }
      ],
      "post_action": "systemctl daemon-reload"
    },
    {
      "id": "patch-webapp-env",
      "kind": "patch_env_file",
      "title": "Adding new env var to webapp .env",
      "patches": [
        {
          "op": "set_env",
          "file": "/home/jambonz/apps/webapp/.env",
          "key": "WEBAPP_NEW_FEATURE",
          "value": "true"
        }
      ]
    },
    {
      "id": "restart-something",
      "kind": "restart_unit",
      "title": "Restarting some unit (config-only change example)",
      "manager": "systemd",
      "unit": "some-unit"
    }
  ]
}
